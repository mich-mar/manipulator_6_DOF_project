# Doxyfile 1.9.x

# Project details
PROJECT_NAME           = "Manipulator6DOF"
PROJECT_BRIEF          = "Documentation for the Manipulator6DOF project"
OUTPUT_DIRECTORY       = docs
OUTPUT_LANGUAGE        = English
INPUT                  = src inc
FILE_PATTERNS          = *.cpp *.h
RECURSIVE              = YES

# Build options
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
EXTRACT_ANON_NSPACES   = YES

# Source browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
STRIP_CODE_COMMENTS    = YES

# HTML output
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES

# Dot diagrams (optional but recommended)
HAVE_DOT               = YES
DOT_NUM_THREADS        = 2
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
CLASS_DIAGRAMS         = YES
COLLABORATION_GRAPH    = YES
UML_LOOK               = YES

# Input encoding
INPUT_ENCODING         = UTF-8

# Other settings
QUIET                  = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_LOGFILE           = docs/doxygen_warnings.log

# Exclude
EXCLUDE                = cmake-build-debug docs/html
