           <item>
            <widget class="QDial" name="dialAngle1">
             <property name="styleSheet">
              <string notr="true">QPushButton {
    max-width: 50px;          /* zmienione z width na max-width */
    max-height: 50px;         /* zmienione z height na max-height */
    background-color: #4169E1;
    border-radius: 5px;
    color: white;
    font-size: 7pt;
    font-weight: bold;
}

QDial {
    background-color: #4169E1;
    border-radius: 4px;
    border: 1px solid #3158DB;
    max-width: 50px;          /* zmienione z min-width na max-width */
    max-height: 50px;         /* zmienione z min-height na max-height */
    /* Dodane właściwości dla zakresu i pozycji */
    qproperty-minimum: -180;
    qproperty-maximum: 180;
    qproperty-startAngle: 90;
    qproperty-spanAngle: 360;
    qproperty-notchesVisible: true;
    qproperty-wrapping: false;
}

QDial::groove {
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
                                     fx:0.5, fy:0.5,
                                     stop:0 #6183E4,
                                     stop:1 #3158DB);
    border-radius: 4px;
}

QDial::handle {
    background-color: #819EF0;
    border: 1px solid #3158DB;
    border-radius: 2px;
    width: 8px;
    height: 8px;
}</string>
             </property>
            </widget>
           </item>
